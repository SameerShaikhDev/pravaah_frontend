# Local development: Vite proxies /api to http://localhost:5000 (see vite.config.js)
VITE_API_BASE_URL=/api/v1

# Production (Vercel/Netlify etc.): set this to your FULL backend URL, e.g.
# VITE_API_BASE_URL=https://your-backend.example.com/api/v1
# Backend must also set CLIENT_URL=https://your-frontend.example.com (CORS + cookies).
